{
  "info": {
    "name": "FoodOrder API Collection",
    "description": "API endpoints for the Food Ordering Application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/users",
            "description": "List all users available for login"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"userId\": \"<user-uuid>\" }"
            },
            "description": "Login with a user ID, returns JWT token"
          }
        }
      ]
    },
    {
      "name": "Restaurants",
      "item": [
        {
          "name": "List Restaurants",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/restaurants",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "List restaurants (filtered by country for non-admin users)"
          }
        },
        {
          "name": "Get Restaurant",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/restaurants/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get a single restaurant (access checked by country)"
          }
        },
        {
          "name": "Get Restaurant Menu",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/restaurants/:id/menu",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Get menu items for a restaurant"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "List orders (Admin=all, Manager=country, Member=own)"
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant_id\": \"<restaurant-uuid>\",\n  \"items\": [\n    { \"menu_item_id\": \"<menu-item-uuid>\", \"quantity\": 2 }\n  ]\n}"
            },
            "description": "Create a new order with items"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/:id/cancel",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Cancel an order (Admin and Manager only)"
          }
        },
        {
          "name": "Checkout Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/:id/checkout",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Checkout/place an order (Admin and Manager only)"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "List Payment Methods",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/payments/methods",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "List payment methods (Admin only)"
          }
        },
        {
          "name": "Add Payment Method",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/methods",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"paymentMethodId\": \"pm_card_visa\" }"
            },
            "description": "Add a payment method (Admin only)"
          }
        },
        {
          "name": "Remove Payment Method",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/payments/methods/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Remove a payment method (Admin only)"
          }
        },
        {
          "name": "Set Default Payment Method",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/payments/methods/:id/default",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Set a payment method as default (Admin only)"
          }
        },
        {
          "name": "Create Setup Intent",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/setup-intent",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Create a Stripe SetupIntent for adding cards (Admin only)"
          }
        },
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/create-payment-intent",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"amount\": 29.99 }"
            },
            "description": "Create a Stripe PaymentIntent for checkout (Admin and Manager)"
          }
        }
      ]
    }
  ]
}
